# Suppress Uvicorn HTTP access log for /metrics scrapes
#
# uvicorn.Config(access_log=True) is hardcoded, causing a log line per
# Prometheus scrape (every 5s by default).  At a 5s scrape interval this
# produces ~17,000 lines per day of pure noise in `docker logs`.
#
# Set access_log=False unconditionally: the LMCache HTTP server is an
# internal metrics/management endpoint, not a user-facing API, so access
# logging provides no operational value and obscures real log messages.
--- a/lmcache/v1/multiprocess/http_server.py
+++ b/lmcache/v1/multiprocess/http_server.py
@@ -251,7 +251,7 @@ def _run_http_server(
     config = uvicorn.Config(
         app=app,
         host=http_config.http_host,
         port=http_config.http_port,
         log_level="info",
-        access_log=True,
+        access_log=False,
     )
