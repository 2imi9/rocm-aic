# Fix lmcache_mp_l1_memory_usage_bytes and lmcache_mp_l1_usage_ratio always reporting 0
#
# In standard DRAM L1 MP mode, LMCache uses MixedMemoryAllocator as the
# backing store for the pinned CPU L1 pool.  L1Manager.get_memory_usage()
# delegates to the allocator: it first checks `hasattr(allocator, "get_memory_usage")`
# and falls through to an isinstance() chain that handles only LazyMemoryAllocator
# and MixedMemoryAllocator-with-address_manager.  MixedMemoryAllocator had neither
# get_memory_usage() nor a directly-accessible address_manager attribute, so the
# method fell through to a NotImplementedError that was caught silently upstream,
# causing both gauges to permanently report 0.0.
#
# Fix: add get_memory_usage() to MixedMemoryAllocator.  The method reads
# used/free bytes directly from the TensorMemoryAllocator's AddressManager,
# which already tracks every allocation and free.  After this patch:
#
#   lmcache_mp_l1_memory_usage_bytes  — reports real bytes in use
#   lmcache_mp_l1_usage_ratio         — reports real used/total fraction
#
# PagedTensorMemoryAllocator (use_paging=True) does not expose an AddressManager;
# for that case the method falls back to reporting full capacity as used, which
# is conservative but never silently hides allocations.
--- a/lmcache/v1/memory_allocators/mixed_memory_allocator.py
+++ b/lmcache/v1/memory_allocators/mixed_memory_allocator.py
@@ -260,6 +260,30 @@ class MixedMemoryAllocator(MemoryAllocatorInterface):
             )
             self._unregistered = True

+    def get_memory_usage(self) -> tuple[int, int]:
+        """Return (used_bytes, total_bytes) for the pinned DRAM L1 pool.
+
+        Delegates to the underlying TensorMemoryAllocator's AddressManager so
+        that L1Manager.get_memory_usage() — and by extension the
+        lmcache_mp_l1_memory_usage_bytes and lmcache_mp_l1_usage_ratio
+        Prometheus gauges — report real values instead of 0.
+
+        Buffer allocations (BINARY_BUFFER format) are excluded: they are
+        temporary staging buffers that do not contribute to the KV L1 pool.
+        """
+        from lmcache.v1.memory_allocators.tensor_memory_allocator import (
+            TensorMemoryAllocator,
+        )
+
+        if isinstance(self.pin_allocator, TensorMemoryAllocator):
+            am = self.pin_allocator.address_manager
+            free = am.get_free_size()
+            total = am.get_heap_size()
+            return total - free, total
+        # Paged allocator or unknown: report full capacity as used rather than
+        # silently returning 0 which would mask real allocations.
+        return self.size, self.size
+
     def get_paged_buffers(self) -> Optional[tuple[torch.Tensor, ...]]:
         """
         Get the paged buffers for fixed buffer registration.
